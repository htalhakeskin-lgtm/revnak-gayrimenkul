# Yerel geliştirme için bu dosyayı .env.local olarak kopyalayıp doldurun. Gerçek değerleri depoya eklemeyin.

# Neon Postgres bağlantısı (Vercel → Storage → Neon otomatik ekler)
DATABASE_URL=

# Panel oturum çerezini imzalar. Üretmek için: openssl rand -base64 32
SESSION_SECRET=

# Panel parolasının bcrypt hash'i, Base64 ile. Üretmek için: npm run panel:parola -- "parolaniz"
PANEL_PASSWORD_HASH_B64=

# İsteğe bağlı: paylaşım bağlantıları ve site haritası için kök adres (Vercel'de otomatik)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
